# ============================================================
# Pincel de Luz — Variáveis de Ambiente (build-time / Vite)
# ============================================================
# Estas variáveis são INJETADAS NO BUNDLE durante `npm run build`.
# São CHAVES PÚBLICAS (anon key do Supabase) — seguras para frontend.
# Backend privado (service_role) NUNCA vai aqui — fica em Edge Functions.
#
# Uso:
#   1) Copie este arquivo:           cp .env.example .env
#   2) Preencha com seus valores
#   3) Rode o build:                 npm run build
#   4) Suba a pasta dist/ para a VPS
# ============================================================

# URL do seu projeto Supabase / Lovable Cloud
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave PUBLISHABLE (anon) — segura no frontend
VITE_SUPABASE_PUBLISHABLE_KEY="ey..."

# ID do projeto (referenciado em alguns componentes)
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"
